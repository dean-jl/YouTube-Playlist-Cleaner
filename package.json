{
  "name": "youtube-playlist-cleaner",
  "version": "1.3.0",
  "description": "Selectively remove items from your YouTube playlists.",
  "scripts": {
    "clean": "rimraf dist",
    "build:ts": "tsc",
    "copy:assets": "cpy 'src/**/*' '!src/**/*.ts' '!src/**/*.js' dist",
    "build": "npm run clean && npm run build:ts && npm run copy:assets",
    "test": "node --test 'tests/**/*.test.mjs'",
    "package": "node scripts/package.js all",
    "package:chrome": "node scripts/package.js chrome",
    "package:edge": "node scripts/package.js edge",
    "package:firefox": "node scripts/package.js firefox",
    "package:safari": "node scripts/package.js safari",
    "verify:package": "node scripts/package.js verify"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "cpy-cli": "^5.0.0",
    "rimraf": "^5.0.7",
    "typescript": "^5.5.3"
  },
  "private": true,
  "license": "MIT"
}
